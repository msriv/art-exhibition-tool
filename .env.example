# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Database (Turso / libSQL)
# ---------------------------------------------------------------------------
# Local development against a SQLite file — no auth token needed:
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Turso (get both from `turso db show <name>` and `turso db tokens create <name>`):
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=<auth token>

