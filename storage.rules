rules_version = '2';

// All real access goes through the server: uploads via a signed URL issued
// by an API route (§3, milestone 7), reads via the Firebase Admin SDK, which
// bypasses these rules entirely. This file is defense-in-depth only — it
// stops a client SDK from ever touching the bucket directly, in case one
// gets pointed at this project by mistake.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
